# ---------------------------------------------------------------------------
# Fyrion configuration example.
#
#   cp .env.example .env
#
# Fill in real values in .env and never commit that file. Every value below is
# optional except DISCORD_TOKEN; Fyrion validates the whole file at startup and
# refuses to run with one readable error message rather than failing later.
# ---------------------------------------------------------------------------

# Required: bot token from the Discord Developer Portal. Keep this secret; if it
# is ever exposed, reset it in the portal immediately.
DISCORD_TOKEN=your_bot_token_here

# Optional: development | testing | production
# production additionally requires https for the dashboard and forbids
# disabling Secure cookies.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Gateway
#
# Fyrion needs two PRIVILEGED intents, both enabled in the Developer Portal
# under Bot > Privileged Gateway Intents:
#   * Server Members Intent  - autorole, welcome/leave, invite tracking
#   * Message Content Intent - AutoMod, leveling, AFK
# Without them the gateway refuses the connection.
# ---------------------------------------------------------------------------

# Optional: fixed shard count. Leave unset to use Discord's recommendation.
# SHARD_COUNT=2

# Optional: how many messages discord.py keeps cached. The audit log's
# delete/edit events only fire for cached messages, so 0 disables them.
MESSAGE_CACHE_SIZE=1000

# Optional: the activity shown under the bot's name.
ACTIVITY_NAME=/help

# Optional: sync the global application command tree on every startup.
# Set to false if you sync manually, to avoid Discord's sync rate limit.
SYNC_COMMANDS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Optional: SQLite database path.
#   Local run:  fyrion.db
#   Docker run: /data/fyrion.db  (persisted via the fyrion-data volume)
DATABASE_URL=fyrion.db

# Optional: number of pooled aiosqlite connections.
# SQLite permits many readers but only one writer, so small values are best.
# Forced to 1 automatically when DATABASE_URL is an in-memory database.
DATABASE_POOL_SIZE=5

# Optional: how long (milliseconds) a writer waits on a locked database before
# raising "database is locked".
DATABASE_BUSY_TIMEOUT_MS=5000

# Optional: seconds between incremental vacuum / WAL checkpoint passes.
DATABASE_MAINTENANCE_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Optional: console log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# The rotating file handler always records DEBUG.
LOG_LEVEL=INFO

# Optional: text (human readable) or json (one object per line, for shippers).
LOG_FORMAT=text

# Optional: rotating file logging.
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=fyrion.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional: verbosity of discord.py's own loggers.
DISCORD_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Web dashboard (optional, disabled by default)
#
# Every /api route requires a Discord OAuth session AND the Manage Server
# permission on the target guild. Enabling the dashboard therefore requires
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET and DASHBOARD_SECRET_KEY; Fyrion
# refuses to start the HTTP server without them, because an unauthenticated
# admin API is not an acceptable default.
# ---------------------------------------------------------------------------

DASHBOARD_ENABLED=false

# Bind address. Keep 127.0.0.1 unless a reverse proxy terminates TLS in front.
# Inside Docker this must be 0.0.0.0 for the port mapping to work.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Public URL the dashboard is served under. Must be https in production.
DASHBOARD_BASE_URL=http://127.0.0.1:8080

# OAuth redirect path. The full URI (DASHBOARD_BASE_URL + this path) must be
# registered in the Developer Portal under OAuth2 > Redirects, character for
# character.
DASHBOARD_OAUTH_CALLBACK_PATH=/callback

# Application credentials from the Developer Portal (OAuth2 section).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signing key for session cookies and OAuth state. At least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=

# Session lifetime in seconds (default 12 hours).
DASHBOARD_SESSION_TTL_SECONDS=43200

# Comma-separated browser origins allowed to call the API with cookies.
# Leave empty when the UI is served from DASHBOARD_BASE_URL itself.
# '*' is rejected: credentialed requests require explicit origins.
DASHBOARD_ALLOWED_ORIGINS=

# Comma-separated Host header allow-list. Defaults to localhost plus the
# hostname in DASHBOARD_BASE_URL. This blocks Host-header attacks and DNS
# rebinding against a loopback bind.
DASHBOARD_TRUSTED_HOSTS=

# Mark session cookies Secure. Defaults to true when DASHBOARD_BASE_URL is
# https, and cannot be disabled in production.
# DASHBOARD_COOKIE_SECURE=true

# Optional cookie domain (only needed for subdomain sharing).
# DASHBOARD_COOKIE_DOMAIN=

# Log every HTTP request. Off by default: access logs record IP addresses.
DASHBOARD_ACCESS_LOG=false

# Enable only when a trusted reverse proxy sets X-Forwarded-For/Proto.
# Trusting these headers without a proxy lets clients spoof their IP, which
# would defeat the rate limiter below.
DASHBOARD_TRUST_PROXY=false
# DASHBOARD_FORWARDED_ALLOW_IPS=127.0.0.1

# Per-IP rate limits (requests per window / window in seconds).
DASHBOARD_RATE_LIMIT=60
DASHBOARD_RATE_LIMIT_WINDOW=60
DASHBOARD_AUTH_RATE_LIMIT=10

# Optional: cap on members returned by dashboard lookups.
DASHBOARD_MEMBER_LOOKUP_LIMIT=50
